APP_NAME="ULove"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Старые домены (через запятую): запросы к ним 301/308 редиректятся на APP_URL.
APP_LEGACY_HOSTS=upin.laravel.cloud
# Опционально: вручную зафиксировать версию билда (иначе берется хэш public/build/manifest.json).
# В Laravel Cloud можно задать как переменную окружения, например APP_VERSION=$LARAVEL_CLOUD_COMMIT
# APP_VERSION=

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=live_map
DB_USERNAME=root
DB_PASSWORD=

# Порт Docker-MySQL на хосте (внутри сети всегда 3306).
# На Windows 3306 часто занят нативным MySQL — по умолчанию 3307.
# Для доступа с хоста (artisan без docker, TablePlus) поставь в своём .env DB_PORT=3307.
MYSQL_PORT=3307

SESSION_DRIVER=database
SESSION_LIFETIME=20160
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# Server-side публикация событий: хост самого Reverb-процесса (loopback!).
# НЕ ставить 0.0.0.0 — POST на bind-адрес падает и события никому не долетают.
REVERB_APP_ID=app-id
REVERB_APP_KEY=app-key
REVERB_APP_SECRET=app-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Лимит одновременных WS-соединений (пусто = без лимита).
# Если в панели 100/100 и новые клиенты не получают realtime — поднять.
# REVERB_APP_MAX_CONNECTIONS=1000

# Фронтенд: на проде (один порт 443 за прокси, nginx /app -> 8080)
# VITE_REVERB_HOST=<публичный домен>, VITE_REVERB_PORT=443, VITE_REVERB_SCHEME=https.
# Пустой/loopback VITE_REVERB_HOST на реальном домене сам подхватит хост страницы.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_EMAIL="admin@example.com"
# Прод на Laravel Cloud: исходящий SMTP (25/465/587) с контейнеров обычно
# заблокирован — SMTP будет падать с таймаутом/500. Используй API-драйвер:
#   composer require resend/resend-php
#   MAIL_MAILER=resend
#   RESEND_API_KEY=re_xxx (секреты окружения в Cloud, не коммитить)
#   MAIL_FROM_ADDRESS=noreply@твой-домен (домен верифицирован в Resend)
# Диагностика: php artisan mail:health / php artisan mail:health --send=you@example.com
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Expo Push Service (системные пуши Android, шторка + бейдж).
# Взять: https://expo.dev → аккаунт farid3301 → Access Tokens → Create.
# Без него пуши тоже шлются, но с лимитами; с ним — стабильно + выше квоты.
EXPO_ACCESS_TOKEN=

# Шифрование messages.body (AES-256-GCM, base64 32 байт).
# Сгенерировать: php -r "echo base64_encode(random_bytes(32)).PHP_EOL;"
# Пусто = производный ключ от APP_KEY (не хранить plaintext).
MESSAGE_CRYPTO_KEY=

# Video P2P (WebRTC): STUN всегда, TURN — обязательно для прода.
# Без TURN ~30% звонков за симметричным NAT/мобильными сетями не встают:
# звонок принимается (сигналинг ок), но чёрный экран и тишина (медиа нет).
# Фронт берёт ICE с бэкенда GET /api/video/ice-servers (креды временные).
#
# Вариант A — статика (свой coturn на VPS или Metered.ca / Xirsys):
#   TURN_URLS="turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp"
#   TURN_USERNAME=upin
#   TURN_CREDENTIAL=secret
# Вариант B — coturn REST (временные креды по секрету из turnserver.conf static-auth-secret):
#   TURN_URLS="turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp"
#   TURN_SECRET=very-long-random-secret
# Вариант C — Cloudflare Calls TURN (домен на Cloudflare, свой coturn не нужен):
#   CF_TURN_KEY_ID=
#   CF_TURN_API_TOKEN=
#   CF_TURN_TTL_HOURS=24
# Laravel Cloud: свой coturn там не поднять (нет UDP-портов) — бери A (Metered)
# или C (Cloudflare). Легаси VITE_TURN_* ниже — фолбэк, можно не задавать.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
CF_TURN_TTL_HOURS=24
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Telegram Mini App (@U1ove_bot). Токен — только в .env / секреты прода, в git не коммитить.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=U1ove_bot
TELEGRAM_AUTO_REGISTER=true
TELEGRAM_INITDATA_MAX_AGE=86400
# Секрет вебхука бота (панель сеансов в чате). Сгенерировать: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
# Тот же секрет уйдёт в setWebhook через `php artisan telegram:setup-bot`.
TELEGRAM_WEBHOOK_SECRET=
# Grandfather-дата обязательной анкеты (Y-m-d H:i:s): аккаунты, созданные раньше,
# от онбординга освобождены, требование только для новых.
ONBOARDING_REQUIRED_SINCE="2026-10-15 00:00:00"

# Cloudflare Turnstile (капча от ботов/скраппинга на регистрации,
# входе после фейлов, восстановлении пароля и гостевых заявках).
# Взять: https://dash.cloudflare.com → Turnstile → Add widget → Managed.
# Без ключей капча пропускает всех (dev), виджет на фронте скрыт.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Принудительно выключить капчу (e2e-тесты): TURNSTILE_ENABLED=false
# TURNSTILE_ENABLED=true
# Таймаут серверной проверки токена, секунды.
# TURNSTILE_VERIFY_TIMEOUT=5

# AI-ассистент (Laravel AI SDK). Основной — OpenRouter (доступен из РБ/СНГ, free-модели без карты).
# Ключ: openrouter.ai → Keys. В git не коммитить.
AI_DEFAULT_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Модели OpenRouter со суффиксом :free (можно не трогать).
OPENROUTER_TEXT_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_SMART_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_CHEAP_MODEL=nvidia/nemotron-3.5-lightning:free
# OpenCode Zen — запасной провайдер (free-модели, ключ: opencode.ai → Zen).
# Без ключа просто не используется, основной OpenRouter продолжает работать.
ZEN_API_KEY=
ZEN_TEXT_MODEL=mimo-v2.6-flash-free

SIGHTENGINE_API_USER=
SIGHTENGINE_API_KEY=

PIPE_DOMAIN=pipe.ulove.by
# Пусто/не задано в local: мини-сайт работает по пути /pipe главного приложения
