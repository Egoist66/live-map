APP_NAME="UPin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Опционально: вручную зафиксировать версию билда (иначе берется хэш public/build/manifest.json).
# В Laravel Cloud можно задать как переменную окружения, например APP_VERSION=$LARAVEL_CLOUD_COMMIT
# APP_VERSION=

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=live_map
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# Server-side публикация событий: хост самого Reverb-процесса (loopback!).
# НЕ ставить 0.0.0.0 — POST на bind-адрес падает и события никому не долетают.
REVERB_APP_ID=app-id
REVERB_APP_KEY=app-key
REVERB_APP_SECRET=app-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Лимит одновременных WS-соединений (пусто = без лимита).
# Если в панели 100/100 и новые клиенты не получают realtime — поднять.
# REVERB_APP_MAX_CONNECTIONS=1000

# Фронтенд: на проде (один порт 443 за прокси, nginx /app -> 8080)
# VITE_REVERB_HOST=<публичный домен>, VITE_REVERB_PORT=443, VITE_REVERB_SCHEME=https.
# Пустой/loopback VITE_REVERB_HOST на реальном домене сам подхватит хост страницы.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Firebase Cloud Messaging (нативные пуши Android/iOS).
# Положи service-account JSON из Firebase Console в storage/app/firebase/service-account.json
# или укажи свой путь здесь. Файл с ключом в git не коммитить.
# FIREBASE_CREDENTIALS=

# Mobile (Capacitor, server.url-режим)
# VITE_API_URL — origin API для натива (без /api на конце, web оставить пустым).
# CAP_SERVER_URL — прод-домен, который грузит WebView (staging/prod).
# VITE_API_URL=
# CAP_SERVER_URL=https://upin.laravel.cloud
