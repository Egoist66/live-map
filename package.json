{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vue-tsc && vite build",
        "build:ssr": "vue-tsc && vite build && vite build --ssr",
        "dev": "concurrently \"php artisan serve\" \"php artisan reverb:start --debug\" \"vite\"",
        "dev:ssr": "concurrently \"php artisan serve\" \"php artisan reverb:start --debug\" \"php artisan inertia:start-ssr\" \"vite\"",
        "docker:up": "docker compose up --build",
        "docker:dev": "docker compose --profile dev up --build",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f",
        "docker:restart": "docker compose down && docker compose up --build -d",
        "docker:clean": "docker compose down -v --remove-orphans",
        "docker:build": "docker compose build"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "autoprefixer": "^10.4.12",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.2.1",
        "typescript": "^5.6.3",
        "vite": "^8.0.0",
        "vue": "^3.4.0",
        "vue-tsc": "^2.0.24"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@pinia/colada": "^1.4.4",
        "@primeuix/themes": "^3.0.0",
        "@vee-validate/zod": "^4.15.1",
        "axios": "^1.20.0",
        "date-fns": "^4.4.0",
        "laravel-echo": "^2.4.0",
        "maplibre-gl": "^6.6.0",
        "pinia": "^4.0.3",
        "primeicons": "^8.0.0",
        "primevue": "^5.0.1",
        "pusher-js": "^8.6.0",
        "vee-validate": "^4.15.1",
        "zod": "^3.25.76"
    }
}
