{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vue-tsc && vite build && node scripts/copy-sw.mjs",
        "build:ssr": "vue-tsc && vite build && node scripts/copy-sw.mjs && vite build --ssr",
        "pwa:copy": "node scripts/copy-sw.mjs",
        "cap:sync": "npx cap sync",
        "mobile:build": "npm run build && npx cap sync",
        "mobile:android": "node scripts/mobile-android.mjs release",
        "mobile:android:release": "node scripts/mobile-android.mjs release",
        "mobile:android:debug": "node scripts/mobile-android.mjs debug",
        "mobile:icons": "node scripts/gen-android-icons.mjs",
        "mobile:open:android": "npx cap open android",
        "mobile:open:ios": "npx cap open ios",
        "dev": "concurrently \"php artisan serve\" \"php artisan reverb:start --debug\" \"vite\"",
        "dev:ssr": "concurrently \"php artisan serve\" \"php artisan reverb:start --debug\" \"php artisan inertia:start-ssr\" \"vite\"",
        "docker:up": "docker compose up --build",
        "docker:dev": "docker compose --profile dev up --build",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f",
        "docker:restart": "docker compose down && docker compose up --build -d",
        "docker:clean": "docker compose down -v --remove-orphans",
        "docker:build": "docker compose build"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/server-renderer": "^3.4.0",
        "autoprefixer": "^10.4.12",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.2.1",
        "typescript": "^5.6.3",
        "vite": "^8.0.0",
        "vite-plugin-pwa": "^1.3.0",
        "vue": "^3.4.0",
        "vue-tsc": "^2.0.24"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@capacitor/android": "8.5.2",
        "@capacitor/app": "8.1.1",
        "@capacitor/camera": "8.2.4",
        "@capacitor/cli": "8.5.2",
        "@capacitor/core": "8.5.2",
        "@capacitor/geolocation": "8.2.2",
        "@capacitor/haptics": "8.0.2",
        "@capacitor/keyboard": "8.0.5",
        "@capacitor/preferences": "8.0.1",
        "@capacitor/push-notifications": "8.1.2",
        "@capacitor/splash-screen": "8.0.2",
        "@capacitor/status-bar": "8.0.3",
        "@capawesome/capacitor-badge": "^8.0.3",
        "@pinia/colada": "^1.4.4",
        "@primeuix/themes": "^3.0.0",
        "@vee-validate/zod": "^4.15.1",
        "@vueuse/core": "^14.4.0",
        "axios": "^1.20.0",
        "date-fns": "^4.4.0",
        "dexie": "^4.4.5",
        "laravel-echo": "^2.4.0",
        "maplibre-gl": "^6.6.0",
        "pinia": "^4.0.3",
        "primeicons": "^8.0.0",
        "primevue": "^5.0.1",
        "pusher-js": "^8.6.0",
        "swiper": "^14.2.0",
        "vee-validate": "^4.15.1",
        "zod": "^3.25.76"
    }
}
